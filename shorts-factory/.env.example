# ShortsFactory-Enterprise — copia a .env (nunca lo subas). En CI van como
# Secrets (claves) y Variables (opciones) del repositorio.

# --- LLM (guiones) --------------------------------------------------------------
SF_LLM=anthropic                 # anthropic | openai | plantilla (solo pruebas, nunca publica)
SF_LLM_MODELO=                   # vacío con anthropic = claude-opus-5-5; obligatorio con openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SF_LLM_CORRECCIONES=2            # rondas de autocorrección contra las heurísticas

# --- Voz --------------------------------------------------------------------------
SF_TTS=kokoro                    # kokoro (Apache-2.0, local) | edge | espeak (solo desarrollo)
SF_KOKORO_VOZ=em_alex            # em_alex, em_santa, ef_dora
SF_EDGE_VOZ=es-MX-JorgeNeural

# --- Video ------------------------------------------------------------------------
SF_FPS=30                        # 30 | 60
SF_DURACION_MAX=15
SF_LUFS=-14
PEXELS_API_KEY=                  # opcional: b-roll vertical (https://www.pexels.com/api/)
SF_REMOTION_BROWSER=             # Chrome headless propio (vacío: Remotion usa el suyo)

# --- YouTube (Data API v3) --------------------------------------------------------
# Contenido JSON COMPLETO del client_secret (OAuth "App de escritorio").
YOUTUBE_CLIENT_SECRET=
# Se obtiene una vez con: python -m shortsfactory auth
YOUTUBE_REFRESH_TOKEN=
SF_YOUTUBE_PRIVACIDAD=private    # private | unlisted | public
SF_YOUTUBE_CATEGORIA=28          # 28 Ciencia y tecnología · 27 Educación
SF_YOUTUBE_CUOTA=10000           # cuota diaria de tu proyecto
SF_YOUTUBE_COSTO_SUBIDA=1600     # unidades por videos.insert según tu proyecto
SF_YOUTUBE_SINTETICO=false       # true si el video muestra personas/hechos realistas generados

# --- Estado y depuración ------------------------------------------------------------
SF_DIR_RUNS=                     # por defecto ./runs
SF_DIR_ESTADO=                   # por defecto ./estado (memoria anti-repetición y cuota)
SF_SEMILLA=                      # fija el diseño (reproducible)
SF_SIMILITUD_MAX=0.35            # parecido máximo con Shorts anteriores
SF_LOG=INFO
