# Copia este archivo a .env y rellena lo que uses. Nunca subas .env al repositorio.

# --- Voz (obligatoria para publicar) -----------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de una voz de la biblioteca con acento latino (Voice Library → filtro
# "Spanish" + "Latin American"). Se copia desde el botón "ID" de la voz.
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 es la de mejor prosodia en español para narración larga.
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Video de stock vía MoneyPrinterTurbo ------------------------------------
# Ruta a un clon de https://github.com/harry0703/MoneyPrinterTurbo con sus
# dependencias instaladas en el mismo entorno de Python.
MPT_DIR=
# https://www.pexels.com/api/  y  https://pixabay.com/api/docs/  (gratis)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Infografías con Remotion -------------------------------------------------
# Por defecto se usa documental/remotion (hay que correr `npm install` ahí).
REMOTION_DIR=
# Chrome/Chromium headless a usar. Vacío: Remotion descarga el suyo.
REMOTION_BROWSER=

# --- Guion con Claude (opcional) ----------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Varios -------------------------------------------------------------------
# Carpeta de salida (por defecto ./salidas)
DOCUMENTAL_SALIDA=
# DEBUG para ver cada comando de ffmpeg
DOCUMENTAL_LOG=INFO
